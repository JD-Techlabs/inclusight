# Copy to .env (never commit .env). Values below match infra/docker-compose.yml for local dev.

# Public base URL of the web app
APP_URL=http://localhost:3000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Also used to encrypt TOTP seeds at rest. Must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-generate-a-long-random-secret

# Postgres
DATABASE_URL=postgres://inclusight:inclusight@localhost:5432/inclusight

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Email (SMTP). Local dev uses Mailpit: UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Inclusight <no-reply@inclusight.local>"

# Object storage (S3-compatible; MinIO locally). Not used by app code until Phase 1.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=inclusight
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Worker
LOG_LEVEL=info

# Scanner. Local development and tests only: lets the scanner reach localhost/private
# addresses (the fixture site on http://localhost:4100). Never enable in production.
SCANNER_ALLOW_PRIVATE_HOSTS=false

# Worker health endpoint (http://127.0.0.1:4101/health)
WORKER_HEALTH_PORT=4101

# Tests only: path to a local veraPDF CLI for the PDF/UA tests. When unset, the tests use the
# verapdf/cli Docker image. CI sets VERAPDF_REQUIRED=1 so a missing validator fails the build.
# VERAPDF_BIN=
