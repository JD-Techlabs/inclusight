      "properties": {
        "platforms": {
          "type": "number"
        },
        "investorFacing": {
          "type": "number"
        },
        "verified": {
          "type": "number"
        },
        "scanned": {
          "type": "number"
        }
      },
      "required": [
        "platforms",
        "investorFacing",
        "verified",
        "scanned"
