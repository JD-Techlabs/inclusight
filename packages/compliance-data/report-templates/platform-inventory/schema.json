            "string",
            "null"
          ]
        },
        "automatedNote": {
          "type": "string"
        },
        "certificationNote": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "lang",
        "period",
        "generatedOn",
        "generatedBy",
        "draft",
        "draftNote",
        "automatedNote",
        "certificationNote",
        "notes"
